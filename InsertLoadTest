private Map<String, Object> csvBase(
    String operation,
    String recordedAt
) {
    Map<String, Object> row = new LinkedHashMap<>();
    row.put("run_id", runId);
    row.put("recorded_at_utc", recordedAt);
    row.put("operation", operation);
    return row;
}
private double percentile(
    double[] sortedValues,
    double fraction
) {
    if (sortedValues.length == 0) {
        return Double.NaN;
    }
    int index =
        (int) Math.ceil(fraction * sortedValues.length) - 1;
    return sortedValues[index];
}
private boolean isTimeout(CompletableFuture<?> check) {
    return check.handle((ignored, error) -> {
        Throwable cause = error;
        while (cause instanceof CompletionException
                || cause instanceof ExecutionException) {
            cause = cause.getCause();
        }
        return cause instanceof TimeoutException;
    }).join();
}
private static String csvCell(Object value) {
    if (value == null) {
        return "";
    }
    if (value instanceof Double number
            && !Double.isFinite(number)) {
        return "";
    }
    if (value instanceof Float number
            && !Float.isFinite(number)) {
        return "";
    }
    String text = value.toString();
    if (text.contains(",")
            || text.contains("\"")
            || text.contains("\n")
            || text.contains("\r")) {
        return "\"" + text.replace("\"", "\"\"") + "\"";
    }
    return text;
}
private static String csvLine(Object... values) {
    return Arrays.stream(values)
        .map(TestRunner::csvCell)
        .collect(Collectors.joining(","));
}
private void appendCsv(
    String filename,
    List<Map<String, Object>> rows
) {
    if (rows.isEmpty()) {
        return;
    }
    Path file = Path.of(output_dir).resolve(filename);
    List<String> columns =
        new ArrayList<>(rows.get(0).keySet());
    String header = csvLine(columns.toArray());
    for (Map<String, Object> row : rows) {
        if (!columns.equals(new ArrayList<>(row.keySet()))) {
            throw new IllegalArgumentException(
                "Inconsistent CSV columns: " + filename
            );
        }
    }
    synchronized (CSV_LOCK) {
        try {
            Files.createDirectories(
                file.toAbsolutePath().getParent()
            );
            boolean newFile =
                !Files.exists(file) || Files.size(file) == 0;
            if (!newFile) {
                try (BufferedReader reader =
                         Files.newBufferedReader(
                             file,
                             StandardCharsets.UTF_8
                         )) {
                    if (!header.equals(reader.readLine())) {
                        throw new IOException(
                            "CSV header mismatch: " + file
                        );
                    }
                }
            }
            try (BufferedWriter writer =
                     Files.newBufferedWriter(
                         file,
                         StandardCharsets.UTF_8,
                         StandardOpenOption.CREATE,
                         StandardOpenOption.APPEND
                     )) {
                if (newFile) {
                    writer.write(header);
                    writer.write("\r\n");
                }
                for (Map<String, Object> row : rows) {
                    writer.write(
                        csvLine(row.values().toArray())
                    );
                    writer.write("\r\n");
                }
            }
        } catch (IOException e) {
            throw new UncheckedIOException(
                "Could not append " + file,
                e
            );
        }
    }
}

