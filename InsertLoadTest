import com.zaxxer.hikari.HikariDataSource;

import javax.sql.DataSource;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.time.Instant;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicBoolean;

public class TestRunner {

    public static final String SINGLE = "single";
    public static final String BATCH = "batch";

    // Redis read batch size; unrelated to SQL insert batching.
    private static final int REDIS_READ_BATCH_SIZE = 100;

    private final String runId;
    private final SqlServerClientManager sqlClient;
    private final RedisClientManager redisClient;

    private final String keyPrefix;
    private final int recordCount;
    private final int connectionCount;

    // Configuration values are milliseconds.
    private final long pollInterval;
    private final long redisTimeout;

    private final ScheduledThreadPoolExecutor scheduler;

    private final ConcurrentHashMap<Long, PendingRead> pendingReads =
        new ConcurrentHashMap<>();

    private final AtomicBoolean redisRoundRunning =
        new AtomicBoolean(false);

    private record Row(
        Long id,
        String data,
        Timestamp createTimestamp,
        Long createTimestampUnix,
        Timestamp updateTimestamp,
        Long updateTimestampUnix
    ) {
        private Row(
            Long id,
            String data,
            Timestamp updateTimestamp,
            Long updateTimestampUnix
        ) {
            this(
                id,
                data,
                null,
                null,
                updateTimestamp,
                updateTimestampUnix
            );
        }
    }

    record Metric(
        Long id,
        double redisMillis,
        double firstCheckDelayMillis,
        long checks,
        String operation
    ) {}

    private static final class PendingRead {

        final Long id;
        final String key;
        final long committedNanos;

        final CompletableFuture<Metric> result =
            new CompletableFuture<>();

        long firstCheckNanos;
        long checks;

        PendingRead(
            Long id,
            String key,
            long committedNanos
        ) {
            this.id = id;
            this.key = key;
            this.committedNanos = committedNanos;
        }
    }

    public TestRunner(
        Config config,
        String runId,
        SqlServerClientManager sqlClient,
        RedisClientManager redisClient
    ) {
        this.runId = runId;
        this.sqlClient = sqlClient;
        this.redisClient = redisClient;

        this.keyPrefix = config.getRedisKeyPrefix();
        this.recordCount = config.getRecordCount();
        this.connectionCount = config.getConnectionPoolSize();
        this.pollInterval = config.getPollInterval();
        this.redisTimeout = config.getRedisTimeout();

        if (recordCount <= 0 || connectionCount <= 0) {
            throw new IllegalArgumentException(
                "recordCount and connectionPoolSize must be positive"
            );
        }

        if (pollInterval <= 0 || redisTimeout <= 0) {
            throw new IllegalArgumentException(
                "pollInterval and redisTimeout must be positive milliseconds"
            );
        }

        scheduler = new ScheduledThreadPoolExecutor(1);
        scheduler.setRemoveOnCancelPolicy(true);
    }

    public void run() throws InterruptedException {

        List<Row> rows = prepareRows(runId, recordCount);

        ConcurrentLinkedQueue<Metric> metrics =
            new ConcurrentLinkedQueue<>();

        ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks =
            new ConcurrentLinkedQueue<>();

        ThreadPoolExecutor sqlExecutor =
            (ThreadPoolExecutor)
                Executors.newFixedThreadPool(connectionCount);

        try (HikariDataSource pool = sqlClient.createPool()) {

            try {
                System.out.println("Warming SQL connections...");
                warmPool(pool);

                // Warm the existing Redis connection.
                redisClient.exists(keyPrefix + "__warmup__");

                sqlExecutor.prestartAllCoreThreads();
                scheduler.prestartAllCoreThreads();

                // Start observing before submitting SQL inserts.
                ScheduledFuture<?> pollingTask =
                    scheduler.scheduleWithFixedDelay(
                        this::pollRedisBatches,
                        0,
                        pollInterval,
                        TimeUnit.MILLISECONDS
                    );

                System.out.printf(
                    "Starting %,d inserts with %d SQL workers; "
                        + "Redis read batch size=%d%n",
                    recordCount,
                    connectionCount,
                    REDIS_READ_BATCH_SIZE
                );

                long workloadStarted = System.nanoTime();

                List<Future<Long>> inserts = runSingleInserts(
                    rows,
                    sqlExecutor,
                    pool,
                    metrics,
                    redisChecks
                );

                int successfulInserts = 0;
                int failedInserts = 0;

                // Redis polling continues while waiting for SQL tasks.
                for (Future<Long> insert : inserts) {
                    try {
                        insert.get();
                        successfulInserts++;

                    } catch (ExecutionException e) {
                        failedInserts++;

                        if (failedInserts <= 5) {
                            System.err.println(
                                "Insert task failed: " + e.getCause()
                            );
                        }
                    }
                }

                long sqlFinished = System.nanoTime();

                // All SQL tasks have now registered their Redis checks.
                CompletableFuture<Void> allRedisChecks =
                    CompletableFuture.allOf(
                        redisChecks.toArray(
                            new CompletableFuture<?>[0]
                        )
                    );

                try {
                    allRedisChecks.get();

                } catch (ExecutionException e) {
                    System.err.println(
                        "Some Redis observations failed or timed out."
                    );
                }

                long observationFinished = System.nanoTime();

                pollingTask.cancel(false);

                printSummary(
                    successfulInserts,
                    failedInserts,
                    workloadStarted,
                    sqlFinished,
                    observationFinished,
                    redisChecks,
                    metrics
                );

                // Keep report writing here.
                // Run update/delete phases only after the
                // insertion observation phase has finished.

            } finally {
                sqlExecutor.shutdownNow();
                scheduler.shutdownNow();

                if (!sqlExecutor.awaitTermination(
                        60, TimeUnit.SECONDS)) {
                    System.err.println(
                        "SQL executor is still terminating."
                    );
                }

                if (!scheduler.awaitTermination(
                        5, TimeUnit.SECONDS)) {
                    System.err.println(
                        "Redis scheduler is still terminating."
                    );
                }
            }

        } catch (SQLException e) {
            throw new RuntimeException(
                "SQL setup or connection warm-up failed",
                e
            );

        } finally {
            sqlExecutor.shutdownNow();
            scheduler.shutdownNow();

            // Complete remaining trackers if the run was interrupted.
            pendingReads.forEach((id, pending) ->
                pending.result.completeExceptionally(
                    new CancellationException("Test run stopped")
                )
            );

            pendingReads.clear();
        }
    }

    private List<Future<Long>> runSingleInserts(
        List<Row> rows,
        ThreadPoolExecutor sqlExecutor,
        HikariDataSource pool,
        ConcurrentLinkedQueue<Metric> metrics,
        ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks
    ) {
        List<Future<Long>> futures =
            new ArrayList<>(rows.size());

        for (Row row : rows) {
            futures.add(sqlExecutor.submit(() -> {

                Long id = sqlClient.insert(
                    pool,
                    row.data(),
                    row.createTimestamp(),
                    row.createTimestampUnix(),
                    row.updateTimestamp(),
                    row.updateTimestampUnix()
                );

                // Assumes insert() returns after successful commit.
                long committedNanos = System.nanoTime();

                redisChecks.add(
                    waitForKeyInRedis(
                        id,
                        committedNanos,
                        metrics
                    )
                );

                return id;
            }));
        }

        return futures;
    }

    /**
     * Registers a committed SQL record for the shared JSON.MGET reader.
     * No Redis request is made here and no thread waits for the key.
     */
    public CompletableFuture<Void> waitForKeyInRedis(
        Long id,
        long committedNanos,
        ConcurrentLinkedQueue<Metric> metrics
    ) {
        PendingRead pending = new PendingRead(
            id,
            buildRedisKey(id),
            committedNanos
        );

        if (pendingReads.putIfAbsent(id, pending) != null) {
            return CompletableFuture.failedFuture(
                new IllegalStateException(
                    "Duplicate pending record ID: " + id
                )
            );
        }

        // Completes after the successful metric has been collected.
        return pending.result.thenAccept(metrics::add);
    }

    /**
     * Takes a snapshot of pending keys and submits JSON.MGET requests
     * in groups. Missing keys remain pending for the next round.
     */
    private void pollRedisBatches() {

        if (!redisRoundRunning.compareAndSet(false, true)) {
            return;
        }

        List<CompletableFuture<Void>> requests =
            new ArrayList<>();

        try {
            List<PendingRead> snapshot =
                new ArrayList<>(pendingReads.values());

            for (int offset = 0;
                 offset < snapshot.size();
                 offset += REDIS_READ_BATCH_SIZE) {

                int end = Math.min(
                    offset + REDIS_READ_BATCH_SIZE,
                    snapshot.size()
                );

                List<PendingRead> batch =
                    new ArrayList<>(end - offset);

                long now = System.nanoTime();

                for (int i = offset; i < end; i++) {
                    PendingRead pending = snapshot.get(i);

                    if (pending.result.isDone()) {
                        pendingReads.remove(pending.id, pending);
                        continue;
                    }

                    if (expired(pending, now)) {
                        timeoutPending(pending);
                        continue;
                    }

                    batch.add(pending);
                }

                if (!batch.isEmpty()) {
                    requests.add(readJsonBatch(batch));
                }
            }

        } catch (RuntimeException e) {
            // Do not leave observation futures hanging if the
            // polling round itself fails.
            pendingReads.forEach((id, pending) ->
                failPending(pending, e)
            );

        } finally {
            // Start a new round only after this round's requests
            // have all completed.
            CompletableFuture.allOf(
                requests.toArray(new CompletableFuture<?>[0])
            ).whenComplete((ignored, error) ->
                redisRoundRunning.set(false)
            );
        }
    }

    private CompletableFuture<Void> readJsonBatch(
        List<PendingRead> batch
    ) {
        String[] keys = batch.stream()
            .map(pending -> pending.key)
            .toArray(String[]::new);

        long submittedNanos = System.nanoTime();

        for (PendingRead pending : batch) {
            if (pending.firstCheckNanos == 0) {
                pending.firstCheckNanos = submittedNanos;
            }

            pending.checks++;
        }

        try {
            return redisClient.jsonMgetAsync(keys)
                .<Void>handle((values, error) -> {

                    // Same response timestamp for this batch.
                    // Capture before examining or logging results.
                    long observedNanos = System.nanoTime();

                    if (error != null) {
                        batch.forEach(pending ->
                            failPending(pending, error)
                        );
                        return null;
                    }

                    if (values == null
                            || values.size() != batch.size()) {
                        IllegalStateException failure =
                            new IllegalStateException(
                                "Unexpected JSON.MGET response size"
                            );

                        batch.forEach(pending ->
                            failPending(pending, failure)
                        );

                        return null;
                    }

                    for (int i = 0; i < batch.size(); i++) {
                        PendingRead pending = batch.get(i);

                        if (pending.result.isDone()) {
                            continue;
                        }

                        if (expired(pending, observedNanos)) {
                            timeoutPending(pending);
                            continue;
                        }

                        // jsonMgetAsync() returns serialized JSON,
                        // or Java null for a missing key.
                        String json = values.get(i);

                        if (json != null) {
                            pendingReads.remove(
                                pending.id,
                                pending
                            );

                            pending.result.complete(
                                new Metric(
                                    pending.id,
                                    (observedNanos
                                        - pending.committedNanos)
                                        / 1_000_000.0,
                                    (pending.firstCheckNanos
                                        - pending.committedNanos)
                                        / 1_000_000.0,
                                    pending.checks,
                                    "INSERT"
                                )
                            );
                        }

                        // Missing keys stay in pendingReads.
                    }

                    return null;
                });

        } catch (RuntimeException e) {
            batch.forEach(pending -> failPending(pending, e));
            return CompletableFuture.completedFuture(null);
        }
    }

    private boolean expired(
        PendingRead pending,
        long nowNanos
    ) {
        return nowNanos - pending.committedNanos
            >= TimeUnit.MILLISECONDS.toNanos(redisTimeout);
    }

    private void timeoutPending(PendingRead pending) {
        failPending(
            pending,
            new TimeoutException(
                "Redis key not observed within "
                    + redisTimeout + " ms: " + pending.key
            )
        );
    }

    private void failPending(
        PendingRead pending,
        Throwable error
    ) {
        pendingReads.remove(pending.id, pending);
        pending.result.completeExceptionally(error);
    }

    private String buildRedisKey(Long id) {
        // Keep your original implementation if its format differs.
        return keyPrefix + id;
    }

    private static List<Row> prepareRows(
        String runId,
        int count
    ) {
        List<Row> rows = new ArrayList<>(count);

        for (int i = 0; i < count; i++) {
            Instant now = Instant.now();

            Timestamp timestamp = Timestamp.from(now);
            long unixTimestamp = now.getEpochSecond();

            rows.add(new Row(
                null,
                "insert-" + i + "-" + runId,
                timestamp,
                unixTimestamp,
                timestamp,
                unixTimestamp
            ));
        }

        return List.copyOf(rows);
    }

    private void warmPool(
        DataSource dataSource
    ) throws SQLException {

        List<Connection> connections =
            new ArrayList<>(connectionCount);

        SQLException primaryFailure = null;

        try {
            for (int i = 0; i < connectionCount; i++) {
                Connection connection =
                    dataSource.getConnection();

                connections.add(connection);

                try (PreparedStatement statement =
                         connection.prepareStatement("SELECT 1")) {

                    statement.setQueryTimeout(30);

                    try (var resultSet =
                             statement.executeQuery()) {

                        if (!resultSet.next()
                                || resultSet.getInt(1) != 1) {
                            throw new SQLException(
                                "Connection warm-up failed"
                            );
                        }
                    }
                }
            }

        } catch (SQLException e) {
            primaryFailure = e;
            throw e;

        } finally {
            SQLException cleanupFailure = null;

            for (Connection connection : connections) {
                try {
                    connection.close();

                } catch (SQLException e) {
                    if (cleanupFailure == null) {
                        cleanupFailure = e;
                    } else {
                        cleanupFailure.addSuppressed(e);
                    }
                }
            }

            if (cleanupFailure != null) {
                if (primaryFailure != null) {
                    primaryFailure.addSuppressed(cleanupFailure);
                } else {
                    throw cleanupFailure;
                }
            }
        }
    }

    private void printSummary(
        int successfulInserts,
        int failedInserts,
        long workloadStarted,
        long sqlFinished,
        long observationFinished,
        ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks,
        ConcurrentLinkedQueue<Metric> metrics
    ) {
        double sqlSeconds =
            (sqlFinished - workloadStarted)
                / 1_000_000_000.0;

        double totalSeconds =
            (observationFinished - workloadStarted)
                / 1_000_000_000.0;

        long failedChecks = redisChecks.stream()
            .filter(CompletableFuture::isCompletedExceptionally)
            .count();

        double averageRedisMillis = metrics.stream()
            .mapToDouble(Metric::redisMillis)
            .average()
            .orElse(Double.NaN);

        double averageFirstCheckDelay = metrics.stream()
            .mapToDouble(Metric::firstCheckDelayMillis)
            .average()
            .orElse(Double.NaN);

        double maxFirstCheckDelay = metrics.stream()
            .mapToDouble(Metric::firstCheckDelayMillis)
            .max()
            .orElse(Double.NaN);

        System.out.printf("""
            
            === INSERT / REDIS JSON SUMMARY ===
            Requested inserts:             %,d
            Successful insert tasks:       %,d
            Failed insert tasks:           %,d
            SQL workload duration:         %.3f seconds
            SQL throughput under polling:  %.1f inserts/second
            Redis observations completed:  %,d
            Redis checks failed/timed out: %,d
            Average observed Redis delay:  %.3f ms
            Average first check delay:     %.3f ms
            Maximum first check delay:     %.3f ms
            Total observation duration:    %.3f seconds
            %n""",
            recordCount,
            successfulInserts,
            failedInserts,
            sqlSeconds,
            successfulInserts / sqlSeconds,
            metrics.size(),
            failedChecks,
            averageRedisMillis,
            averageFirstCheckDelay,
            maxFirstCheckDelay,
            totalSeconds
        );

        metrics.stream()
            .limit(10)
            .forEach(metric -> System.out.printf(
                "ID=%d, Redis=%.3f ms, first check=%.3f ms, checks=%d%n",
                metric.id(),
                metric.redisMillis(),
                metric.firstCheckDelayMillis(),
                metric.checks()
            ));

        redisChecks.stream()
            .filter(CompletableFuture::isCompletedExceptionally)
            .limit(5)
            .forEach(check -> {
                try {
                    check.join();

                } catch (CompletionException e) {
                    System.err.println(
                        "Redis observation failed: " + e.getCause()
                    );
                }
            });
    }

    // Keep your existing update/delete and cleanup methods here.
}
