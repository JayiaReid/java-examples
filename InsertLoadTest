private void awaitAndReportPhase(
    String operation,
    int requested,
    long startedNanos,
    List<? extends Future<?>> sqlTasks,
    ConcurrentLinkedQueue<Metric> metrics,
    ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks
) throws InterruptedException, ExecutionException {
    ExecutionException failure = null;
    try {
        awaitPhase(sqlTasks, redisChecks);
    } catch (ExecutionException e) {
        failure = e;
    }
    long finishedNanos = System.nanoTime();
    // Report the completed phase even if some tasks failed.
    printBenchmarkSummary(
        operation,
        requested,
        startedNanos,
        finishedNanos,
        metrics,
        redisChecks
    );
    if (failure != null) {
        throw failure;
    }
}

This saves results for failed phases while preserving your existing behavior of stopping before the next phase.

6. Replace printOperationSummary() with this method

This calculates the results, prints them, appends your existing text summary, and writes the CSV files.

The column names come directly from ordered maps, so headers and values stay aligned.

private void printBenchmarkSummary(
    String operation,
    int requested,
    long startedNanos,
    long finishedNanos,
    ConcurrentLinkedQueue<Metric> metrics,
    ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks
) {
    List<Metric> observations = List.copyOf(metrics);
    List<Long> commits = List.copyOf(sqlCommitTimes);
    String recordedAt = Instant.now().toString();
    long sqlSucceeded = commits.size();
    long observed = observations.size();
    long lastCommit = commits.stream()
        .mapToLong(Long::longValue)
        .max()
        .orElse(startedNanos);
    double sqlSeconds = sqlSucceeded == 0
        ? Double.NaN
        : (lastCommit - startedNanos) / 1_000_000_000.0;
    double sqlRate = sqlSeconds > 0
        ? sqlSucceeded / sqlSeconds
        : Double.NaN;
    long withinOneSecond = observations.stream()
        .filter(m ->
            m.observedNanos() - m.committedNanos()
                <= TimeUnit.SECONDS.toNanos(1)
        )
        .count();
    long observedBySqlFinish = observations.stream()
        .filter(m -> m.observedNanos() <= lastCommit)
        .count();
    long failed = redisChecks.stream()
        .filter(CompletableFuture::isCompletedExceptionally)
        .count();
    long timeouts = redisChecks.stream()
        .filter(this::isTimeout)
        .count();
    double[] delays = observations.stream()
        .mapToDouble(Metric::redisMillis)
        .sorted()
        .toArray();
    long lastObserved = observations.stream()
        .mapToLong(Metric::observedNanos)
        .max()
        .orElse(startedNanos);
    boolean complete =
        sqlSucceeded == requested
            && observed == requested
            && failed == 0;
    // One summary row, including the test settings.
    Map<String, Object> summary = csvBase(operation, recordedAt);
    summary.put("requested_operations", requested);
    summary.put("sql_workers", connectionCount);
    summary.put("sql_pool_size", connectionCount);
    summary.put("redis_read_batch_size", redisReadBatch);
    summary.put("poll_interval_ms", pollInterval);
    summary.put("redis_timeout_ms", redisTimeout);
    summary.put("sql_commits_acknowledged", sqlSucceeded);
    summary.put(
        "sql_operations_not_acknowledged",
        requested - sqlSucceeded
    );
    summary.put("sql_duration_seconds", sqlSeconds);
    summary.put("sql_acknowledged_operations_per_second", sqlRate);
    summary.put("redis_observations", observed);
    summary.put("observed_within_1_second", withinOneSecond);
    summary.put(
        "observed_after_1_second",
        observed - withinOneSecond
    );
    summary.put("redis_timeouts", timeouts);
    summary.put("redis_other_errors", failed - timeouts);
    summary.put(
        "unconfirmed_at_last_sql_commit",
        sqlSucceeded - observedBySqlFinish
    );
    summary.put(
        "average_delay_ms",
        Arrays.stream(delays).average().orElse(Double.NaN)
    );
    summary.put("p50_delay_ms", percentile(delays, 0.50));
    summary.put("p95_delay_ms", percentile(delays, 0.95));
    summary.put("p99_delay_ms", percentile(delays, 0.99));
    summary.put(
        "maximum_delay_ms",
        delays.length == 0
            ? Double.NaN
            : delays[delays.length - 1]
    );
    summary.put(
        "average_first_check_delay_ms",
        observations.stream()
            .mapToDouble(Metric::firstCheckDelayMillis)
            .average()
            .orElse(Double.NaN)
    );
    summary.put(
        "maximum_first_check_delay_ms",
        observations.stream()
            .mapToDouble(Metric::firstCheckDelayMillis)
            .max()
            .orElse(Double.NaN)
    );
    summary.put(
        "phase_duration_seconds",
        (finishedNanos - startedNanos) / 1_000_000_000.0
    );
    summary.put(
        "all_changes_observed_seconds",
        complete
            ? (lastObserved - startedNanos) / 1_000_000_000.0
            : null
    );
    summary.put(
        "catch_up_seconds",
        complete
            ? Math.max(0L, lastObserved - lastCommit)
                / 1_000_000_000.0
            : null
    );
    summary.put("complete", complete);
    // Arrival counts measured from the start of this phase.
    Map<Long, Long> arrivals = new TreeMap<>();
    for (Metric metric : observations) {
        long second =
            (metric.observedNanos() - startedNanos)
                / TimeUnit.SECONDS.toNanos(1);
        arrivals.merge(second, 1L, Long::sum);
    }
    List<Map<String, Object>> arrivalRows = new ArrayList<>();
    long cumulative = 0;
    long lastSecond = arrivals.keySet().stream()
        .mapToLong(Long::longValue)
        .max()
        .orElse(-1);
    StringBuilder text = new StringBuilder(
        "\n=== " + operation + " BENCHMARK ===\n"
    );
    summary.forEach((key, value) ->
        text.append(key)
            .append(": ")
            .append(csvCell(value).isEmpty() ? "N/A" : value)
            .append('\n')
    );
    for (long second = 0; second <= lastSecond; second++) {
        long count = arrivals.getOrDefault(second, 0L);
        cumulative += count;
        Map<String, Object> row =
            csvBase(operation, recordedAt);
        row.put("window_start_seconds", second);
        row.put("window_end_seconds", second + 1);
        row.put("newly_observed", count);
        row.put("cumulative_observed", cumulative);
        arrivalRows.add(row);
        text.append(String.format(
            Locale.ROOT,
            "%d-%d s: new=%d, cumulative=%d%n",
            second,
            second + 1,
            count,
            cumulative
        ));
    }
    System.out.print(text);
    // Respect your existing configuration setting.
    if (!outputToFile) {
        return;
    }
    appendSummaryToFile(text.toString());
    appendCsv(
        "benchmark-summary.csv",
        List.of(summary)
    );
    // Export every successful per-record observation.
    List<Map<String, Object>> metricRows = new ArrayList<>();
    for (Metric metric : observations) {
        Map<String, Object> row =
            csvBase(operation, recordedAt);
        row.put("record_id", metric.id());
        row.put("status", "OBSERVED");
        row.put("observed_delay_ms", metric.redisMillis());
        row.put(
            "first_check_delay_ms",
            metric.firstCheckDelayMillis()
        );
        row.put("checks", metric.checks());
        row.put("committed_nanos", metric.committedNanos());
        row.put("observed_nanos", metric.observedNanos());
        row.put(
            "commit_offset_ms",
            (metric.committedNanos() - startedNanos)
                / 1_000_000.0
        );
        row.put(
            "observation_offset_ms",
            (metric.observedNanos() - startedNanos)
                / 1_000_000.0
        );
        row.put(
            "observed_within_1_second",
            metric.observedNanos() - metric.committedNanos()
                <= TimeUnit.SECONDS.toNanos(1)
        );
        metricRows.add(row);
    }
    appendCsv("record-metrics.csv", metricRows);
    appendCsv("arrivals-per-second.csv", arrivalRows);
    // Preserve SQL commits even when Redis observation failed.
    List<Map<String, Object>> commitRows = new ArrayList<>();
    for (Long commit : commits) {
        Map<String, Object> row =
            csvBase(operation, recordedAt);
        row.put("committed_nanos", commit);
        row.put(
            "commit_offset_ms",
            (commit - startedNanos) / 1_000_000.0
        );
        commitRows.add(row);
    }
    appendCsv("sql-commits.csv", commitRows);
}

