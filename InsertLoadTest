private CompletableFuture<Void> registerObservation(
    Long id,
    long committedNanos,
    Operation operation,
    String expectedData,
    ConcurrentLinkedQueue<Metric> metrics
) {
    PendingRead pending = new PendingRead(
        id,
        buildRedisKey(id),
        committedNanos,
        operation,
        expectedData
    );

    if (pendingReads.putIfAbsent(id, pending) != null) {
        return CompletableFuture.failedFuture(
            new IllegalStateException(
                "An observation is already pending for ID: " + id
            )
        );
    }

    CompletableFuture<Void> collected =
        pending.result.thenAccept(metrics::add);

    long remainingNanos = Math.max(
        0L,
        TimeUnit.MILLISECONDS.toNanos(redisTimeout)
            - (System.nanoTime() - committedNanos)
    );

    try {
        ScheduledFuture<?> timeoutTask = scheduler.schedule(
            () -> timeoutPending(pending),
            remainingNanos,
            TimeUnit.NANOSECONDS
        );

        pending.result.whenComplete((metric, error) ->
            timeoutTask.cancel(false)
        );

    } catch (RuntimeException e) {
        failPending(pending, e);
    }

    return collected;
}
```

### 4. Add the operation-specific success check

Add this method to `TestRunner`:

```java
private boolean matchesExpectedState(
    PendingRead pending,
    String json
) throws IOException {

    switch (pending.operation) {
        case INSERT:
            return json != null;

        case DELETE:
            return json == null;

        case UPDATE:
            if (json == null) {
                return false;
            }

            // JSON.MGET with "$" returns a JSON array containing
            // the root document: [{"id":123,"data":"new-value"}]
            JsonNode roots = JSON.readTree(json);

            if (roots == null
                    || !roots.isArray()
                    || roots.size() != 1
                    || !roots.get(0).isObject()) {
                throw new IllegalStateException(
                    "Unexpected root JSON for key: " + pending.key
                );
            }

            // Match the actual field name/case in your Redis document.
            JsonNode data = roots.get(0).get("data");

            return data != null
                && data.isTextual()
                && pending.expectedData.equals(data.textValue());

        default:
            throw new IllegalStateException(
                "Unsupported operation: " + pending.operation
            );
    }
}
```

**Check that your Redis field is named `data`.** If RDI uses `"DATA"` or a nested structure, adjust that lookup.

