import com.zaxxer.hikari.HikariDataSource;

import javax.sql.DataSource;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.time.Instant;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.*;

public class TestRunner {

    public static final String SINGLE = "single";
    public static final String BATCH = "batch";

    private final String runId;
    private final SqlServerClientManager sqlClient;
    private final RedisClientManager redisClient;

    private final String keyPrefix;
    private final int recordCount;
    private final int connectionCount;

    // Both configuration values are assumed to be milliseconds.
    private final long pollInterval;
    private final long redisTimeout;

    private final ScheduledThreadPoolExecutor scheduler;

    private record Row(
        Long id,
        String data,
        Timestamp createTimestamp,
        Long createTimestampUnix,
        Timestamp updateTimestamp,
        Long updateTimestampUnix
    ) {
        private Row(
            Long id,
            String data,
            Timestamp updateTimestamp,
            Long updateTimestampUnix
        ) {
            this(
                id,
                data,
                null,
                null,
                updateTimestamp,
                updateTimestampUnix
            );
        }
    }

    record Metric(
        Long id,
        double redisMillis,
        double firstCheckDelayMillis,
        long checks,
        String operation
    ) {}

    public TestRunner(
        Config config,
        String runId,
        SqlServerClientManager sqlClient,
        RedisClientManager redisClient
    ) {
        this.runId = runId;
        this.sqlClient = sqlClient;
        this.redisClient = redisClient;

        this.keyPrefix = config.getRedisKeyPrefix();
        this.recordCount = config.getRecordCount();
        this.connectionCount = config.getConnectionPoolSize();
        this.pollInterval = config.getPollInterval();
        this.redisTimeout = config.getRedisTimeout();

        if (recordCount <= 0 || connectionCount <= 0) {
            throw new IllegalArgumentException(
                "recordCount and connectionPoolSize must be positive"
            );
        }

        if (pollInterval <= 0 || redisTimeout <= 0) {
            throw new IllegalArgumentException(
                "pollInterval and redisTimeout must be positive milliseconds"
            );
        }

        this.scheduler = new ScheduledThreadPoolExecutor(1);

        // Remove cancelled timeout tasks from the scheduler queue.
        this.scheduler.setRemoveOnCancelPolicy(true);
    }

    public void run() throws InterruptedException {

        List<Row> rows = prepareRows(runId, recordCount);

        ConcurrentLinkedQueue<Metric> metrics =
            new ConcurrentLinkedQueue<>();

        ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks =
            new ConcurrentLinkedQueue<>();

        ThreadPoolExecutor sqlExecutor =
            (ThreadPoolExecutor)
                Executors.newFixedThreadPool(connectionCount);

        try (HikariDataSource pool = sqlClient.createPool()) {

            try {
                System.out.println("Warming SQL connections...");
                warmPool(pool);

                // Warm the existing Redis connection before timing.
                // The key does not need to exist.
                redisClient.exists(keyPrefix + "__warmup__");

                sqlExecutor.prestartAllCoreThreads();
                scheduler.prestartAllCoreThreads();

                System.out.printf(
                    "Starting %,d inserts with %d SQL workers%n",
                    recordCount,
                    connectionCount
                );

                long workloadStarted = System.nanoTime();

                List<Future<Long>> inserts = runSingleInserts(
                    rows,
                    sqlExecutor,
                    pool,
                    metrics,
                    redisChecks
                );

                int successfulInserts = 0;
                int failedInserts = 0;

                // Redis checks are already running during this wait.
                for (Future<Long> insert : inserts) {
                    try {
                        insert.get();
                        successfulInserts++;

                    } catch (ExecutionException e) {
                        failedInserts++;

                        // Print only the first few SQL failures.
                        if (failedInserts <= 5) {
                            System.err.println(
                                "Insert task failed: " + e.getCause()
                            );
                        }
                    }
                }

                long sqlFinished = System.nanoTime();

                // All SQL tasks have finished registering their
                // Redis observation futures.
                CompletableFuture<Void> allRedisChecks =
                    CompletableFuture.allOf(
                        redisChecks.toArray(
                            new CompletableFuture<?>[0]
                        )
                    );

                try {
                    allRedisChecks.get();

                } catch (ExecutionException e) {
                    // allOf completes after every check finishes,
                    // including when one or more checks fail.
                    System.err.println(
                        "Some Redis checks failed or timed out."
                    );
                }

                long observationFinished = System.nanoTime();

                printSummary(
                    successfulInserts,
                    failedInserts,
                    workloadStarted,
                    sqlFinished,
                    observationFinished,
                    redisChecks,
                    metrics
                );

                // Keep your existing report writing here.
                // Keep update/delete phases after insertion
                // observations finish.

            } finally {
                sqlExecutor.shutdownNow();
                scheduler.shutdownNow();

                if (!sqlExecutor.awaitTermination(
                        60, TimeUnit.SECONDS)) {
                    System.err.println(
                        "SQL executor is still terminating."
                    );
                }

                if (!scheduler.awaitTermination(
                        5, TimeUnit.SECONDS)) {
                    System.err.println(
                        "Redis scheduler is still terminating."
                    );
                }
            }

        } catch (SQLException e) {
            throw new RuntimeException(
                "SQL setup or connection warm-up failed",
                e
            );

        } finally {
            // Also handles failures while creating the SQL pool.
            sqlExecutor.shutdownNow();
            scheduler.shutdownNow();
        }
    }

    private List<Future<Long>> runSingleInserts(
        List<Row> rows,
        ThreadPoolExecutor sqlExecutor,
        HikariDataSource pool,
        ConcurrentLinkedQueue<Metric> metrics,
        ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks
    ) {
        List<Future<Long>> futures =
            new ArrayList<>(rows.size());

        for (Row row : rows) {
            futures.add(sqlExecutor.submit(() -> {

                // Preserve your existing SQL insert implementation.
                Long id = sqlClient.insert(
                    pool,
                    row.data(),
                    row.createTimestamp(),
                    row.createTimestampUnix(),
                    row.updateTimestamp(),
                    row.updateTimestampUnix()
                );

                // Must be captured after successful SQL commit.
                long sqlCommittedNanos = System.nanoTime();

                // First Redis command is submitted immediately.
                // This does not wait for the key to appear.
                CompletableFuture<Void> observation =
                    waitForKeyInRedis(
                        id,
                        sqlCommittedNanos,
                        metrics
                    );

                redisChecks.add(observation);

                // SQL worker is free to insert the next row.
                return id;
            }));
        }

        return futures;
    }

    public CompletableFuture<Void> waitForKeyInRedis(
        Long id,
        long sqlCommittedNanos,
        ConcurrentLinkedQueue<Metric> metrics
    ) {
        String key = buildRedisKey(id);

        long timeoutNanos =
            TimeUnit.MILLISECONDS.toNanos(redisTimeout);

        long intervalNanos =
            TimeUnit.MILLISECONDS.toNanos(pollInterval);

        CompletableFuture<Metric> observation =
            new CompletableFuture<>();

        class Probe implements Runnable {

            private long firstCheckNanos;
            private long checks;

            private boolean expired(long now) {
                return now - sqlCommittedNanos >= timeoutNanos;
            }

            private void timeout() {
                observation.completeExceptionally(
                    new TimeoutException(
                        "Redis key not observed within "
                            + redisTimeout + " ms: " + key
                    )
                );
            }

            @Override
            public void run() {

                if (observation.isDone()) {
                    return;
                }

                long started = System.nanoTime();

                if (expired(started)) {
                    timeout();
                    return;
                }

                if (firstCheckNanos == 0) {
                    firstCheckNanos = started;
                }

                checks++;

                try {
                    redisClient.existsAsync(key)
                        .whenComplete((exists, error) -> {

                            // Capture before any logging or processing.
                            long observedNanos = System.nanoTime();

                            if (observation.isDone()) {
                                return;
                            }

                            if (error != null) {
                                observation.completeExceptionally(
                                    error
                                );
                                return;
                            }

                            if (expired(observedNanos)) {
                                timeout();
                                return;
                            }

                            if (Boolean.TRUE.equals(exists)) {
                                observation.complete(
                                    new Metric(
                                        id,
                                        (observedNanos
                                            - sqlCommittedNanos)
                                            / 1_000_000.0,
                                        (firstCheckNanos
                                            - sqlCommittedNanos)
                                            / 1_000_000.0,
                                        checks,
                                        "INSERT"
                                    )
                                );

                            } else {
                                scheduleNext();
                            }
                        });

                } catch (RuntimeException e) {
                    observation.completeExceptionally(e);
                }
            }

            private void scheduleNext() {
                if (observation.isDone()) {
                    return;
                }

                try {
                    scheduler.schedule(
                        this,
                        intervalNanos,
                        TimeUnit.NANOSECONDS
                    );

                } catch (RejectedExecutionException e) {
                    observation.completeExceptionally(e);
                }
            }
        }

        Probe probe = new Probe();

        long remainingNanos = Math.max(
            0L,
            timeoutNanos
                - (System.nanoTime() - sqlCommittedNanos)
        );

        try {
            ScheduledFuture<?> timeoutTask =
                scheduler.schedule(
                    probe::timeout,
                    remainingNanos,
                    TimeUnit.NANOSECONDS
                );

            observation.whenComplete((metric, error) ->
                timeoutTask.cancel(false)
            );

            // Directly submit the first asynchronous EXISTS command.
            probe.run();

        } catch (RuntimeException e) {
            observation.completeExceptionally(e);
        }

        // Metrics are added only if observation succeeds.
        // The returned future completes after metrics.add().
        return observation.thenAccept(metrics::add);
    }

    private String buildRedisKey(Long id) {
        // Keep your existing implementation if its format differs.
        return keyPrefix + id;
    }

    private static List<Row> prepareRows(
        String runId,
        int count
    ) {
        List<Row> rows = new ArrayList<>(count);

        for (int i = 0; i < count; i++) {
            Instant now = Instant.now();

            Timestamp timestamp = Timestamp.from(now);
            long unixTimestamp = now.getEpochSecond();

            rows.add(new Row(
                null,
                "insert-" + i + "-" + runId,
                timestamp,
                unixTimestamp,
                timestamp,
                unixTimestamp
            ));
        }

        return List.copyOf(rows);
    }

    private void warmPool(
        DataSource dataSource
    ) throws SQLException {

        List<Connection> connections =
            new ArrayList<>(connectionCount);

        SQLException primaryFailure = null;

        try {
            // Hold each borrowed connection so the next borrow
            // warms a different physical connection.
            for (int i = 0; i < connectionCount; i++) {
                Connection connection =
                    dataSource.getConnection();

                connections.add(connection);

                try (PreparedStatement statement =
                         connection.prepareStatement("SELECT 1")) {

                    statement.setQueryTimeout(30);

                    try (var resultSet =
                             statement.executeQuery()) {

                        if (!resultSet.next()
                                || resultSet.getInt(1) != 1) {
                            throw new SQLException(
                                "Connection warm-up failed"
                            );
                        }
                    }
                }
            }

        } catch (SQLException e) {
            primaryFailure = e;
            throw e;

        } finally {
            SQLException cleanupFailure = null;

            for (Connection connection : connections) {
                try {
                    connection.close();

                } catch (SQLException e) {
                    if (cleanupFailure == null) {
                        cleanupFailure = e;
                    } else {
                        cleanupFailure.addSuppressed(e);
                    }
                }
            }

            if (cleanupFailure != null) {
                if (primaryFailure != null) {
                    primaryFailure.addSuppressed(cleanupFailure);
                } else {
                    throw cleanupFailure;
                }
            }
        }
    }

    private void printSummary(
        int successfulInserts,
        int failedInserts,
        long workloadStarted,
        long sqlFinished,
        long observationFinished,
        ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks,
        ConcurrentLinkedQueue<Metric> metrics
    ) {
        double sqlSeconds =
            (sqlFinished - workloadStarted)
                / 1_000_000_000.0;

        double totalSeconds =
            (observationFinished - workloadStarted)
                / 1_000_000_000.0;

        long failedChecks = redisChecks.stream()
            .filter(CompletableFuture::isCompletedExceptionally)
            .count();

        double averageRedisMillis = metrics.stream()
            .mapToDouble(Metric::redisMillis)
            .average()
            .orElse(Double.NaN);

        double averageFirstCheckDelay = metrics.stream()
            .mapToDouble(Metric::firstCheckDelayMillis)
            .average()
            .orElse(Double.NaN);

        double maxFirstCheckDelay = metrics.stream()
            .mapToDouble(Metric::firstCheckDelayMillis)
            .max()
            .orElse(Double.NaN);

        System.out.printf("""
            
            === INSERT / REDIS SUMMARY ===
            Requested inserts:             %,d
            Successful insert tasks:       %,d
            Failed insert tasks:           %,d
            SQL workload duration:         %.3f seconds
            SQL throughput under polling:  %.1f inserts/second
            Redis observations completed:  %,d
            Redis checks failed/timed out: %,d
            Average observed Redis delay:  %.3f ms
            Average first check delay:     %.3f ms
            Maximum first check delay:     %.3f ms
            Total observation duration:    %.3f seconds
            %n""",
            recordCount,
            successfulInserts,
            failedInserts,
            sqlSeconds,
            successfulInserts / sqlSeconds,
            metrics.size(),
            failedChecks,
            averageRedisMillis,
            averageFirstCheckDelay,
            maxFirstCheckDelay,
            totalSeconds
        );

        // Print a small sample after observation has finished.
        metrics.stream()
            .limit(10)
            .forEach(metric -> System.out.printf(
                "ID=%d, Redis=%.3f ms, first check=%.3f ms, checks=%d%n",
                metric.id(),
                metric.redisMillis(),
                metric.firstCheckDelayMillis(),
                metric.checks()
            ));

        redisChecks.stream()
            .filter(CompletableFuture::isCompletedExceptionally)
            .limit(5)
            .forEach(check -> {
                try {
                    check.join();

                } catch (CompletionException e) {
                    System.err.println(
                        "Redis observation failed: " + e.getCause()
                    );
                }
            });
    }

    // Keep your existing update/delete and cleanup methods here.
}
