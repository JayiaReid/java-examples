private void printBenchmarkSummary(
    String operation,
    int requested,
    long phaseStartedNanos,
    ConcurrentLinkedQueue<Metric> metrics,
    ConcurrentLinkedQueue<CompletableFuture<Void>> redisChecks
) {
    List<Metric> observations = List.copyOf(metrics);
    List<Long> commits = List.copyOf(sqlCommitTimes);
    long sqlSucceeded = commits.size();
    long observed = observations.size();
    long lastCommitNanos = commits.stream()
        .mapToLong(Long::longValue)
        .max()
        .orElse(phaseStartedNanos);
    double sqlDurationSeconds =
        (lastCommitNanos - phaseStartedNanos)
            / 1_000_000_000.0;
    double sqlRate = sqlDurationSeconds > 0
        ? sqlSucceeded / sqlDurationSeconds
        : Double.NaN;
    long withinOneSecond = observations.stream()
        .filter(m ->
            m.observedNanos() - m.committedNanos()
                <= TimeUnit.SECONDS.toNanos(1)
        )
        .count();
    long observedAfterOneSecond =
        observed - withinOneSecond;
    long observedBySqlFinish = observations.stream()
        .filter(m ->
            m.observedNanos() - lastCommitNanos <= 0
        )
        .count();
    long unconfirmedAtSqlFinish =
        sqlSucceeded - observedBySqlFinish;
    long failedChecks = redisChecks.stream()
        .filter(CompletableFuture::isCompletedExceptionally)
        .count();
    long timedOutChecks = redisChecks.stream()
        .filter(this::isTimeout)
        .count();
    long otherReadErrors = failedChecks - timedOutChecks;
    double[] delays = observations.stream()
        .mapToDouble(Metric::redisMillis)
        .sorted()
        .toArray();
    double averageDelay = Arrays.stream(delays)
        .average()
        .orElse(Double.NaN);
    double averageFirstCheck = observations.stream()
        .mapToDouble(Metric::firstCheckDelayMillis)
        .average()
        .orElse(Double.NaN);
    double maximumFirstCheck = observations.stream()
        .mapToDouble(Metric::firstCheckDelayMillis)
        .max()
        .orElse(Double.NaN);
    long lastObservedNanos = observations.stream()
        .mapToLong(Metric::observedNanos)
        .max()
        .orElse(phaseStartedNanos);
    boolean complete =
        sqlSucceeded == requested
            && observed == requested
            && failedChecks == 0;
    String fullCompletion;
    String catchUp;
    if (complete) {
        fullCompletion = String.format(
            "%.3f seconds",
            (lastObservedNanos - phaseStartedNanos)
                / 1_000_000_000.0
        );
        catchUp = String.format(
            "%.3f seconds",
            Math.max(
                0L,
                lastObservedNanos - lastCommitNanos
            ) / 1_000_000_000.0
        );
    } else {
        fullCompletion = "Not established: incomplete results";
        catchUp = "Not established: incomplete results";
    }
    StringBuilder summary = new StringBuilder();
    summary.append(String.format("""
        
        === %s BENCHMARK ===
        Run ID:                              %s
        Recorded at:                         %s
        Requested operations:                %,d
        SQL commits acknowledged:            %,d
        SQL operations not acknowledged:     %,d
        SQL submission-to-last-commit time:   %.3f seconds
        Acknowledged SQL operations/sec:      %.1f
        Changes observed in Redis:           %,d
        Observed within 1 second of commit:   %,d
        Observed after 1 second of commit:    %,d
        Redis observation timeouts:          %,d
        Other Redis observation errors:      %,d
        Unconfirmed at last SQL commit:      %,d
        Average observed delay:              %.3f ms
        P50 observed delay:                  %.3f ms
        P95 observed delay:                  %.3f ms
        P99 observed delay:                  %.3f ms
        Maximum observed delay:              %.3f ms
        Average first-check delay:           %.3f ms
        Maximum first-check delay:           %.3f ms
        Time until all changes observed:     %s
        Catch-up after last SQL commit:      %s
        %n""",
        operation,
        runId,
        Instant.now(),
        requested,
        sqlSucceeded,
        requested - sqlSucceeded,
        sqlDurationSeconds,
        sqlRate,
        observed,
        withinOneSecond,
        observedAfterOneSecond,
        timedOutChecks,
        otherReadErrors,
        unconfirmedAtSqlFinish,
        averageDelay,
        percentile(delays, 0.50),
        percentile(delays, 0.95),
        percentile(delays, 0.99),
        delays.length == 0
            ? Double.NaN
            : delays[delays.length - 1],
        averageFirstCheck,
        maximumFirstCheck,
        fullCompletion,
        catchUp
    ));
    // Arrival windows measured from this phase's start.
    Map<Long, Long> arrivalsPerSecond = new TreeMap<>();
    for (Metric metric : observations) {
        long second =
            (metric.observedNanos() - phaseStartedNanos)
                / TimeUnit.SECONDS.toNanos(1);
        arrivalsPerSecond.merge(second, 1L, Long::sum);
    }
    summary.append(
        "Observed arrivals by second from phase start:\n"
    );
    if (arrivalsPerSecond.isEmpty()) {
        summary.append("No successful observations.\n");
    } else {
        long cumulative = 0;
        long lastSecond = arrivalsPerSecond.keySet().stream()
            .mapToLong(Long::longValue)
            .max()
            .orElse(0);
        for (long second = 0; second <= lastSecond; second++) {
            long newlyObserved =
                arrivalsPerSecond.getOrDefault(second, 0L);
            cumulative += newlyObserved;
            summary.append(String.format(
                "%d–%d s: new=%,d, cumulative=%,d%n",
                second,
                second + 1,
                newlyObserved,
                cumulative
            ));
        }
    }
    summary.append(System.lineSeparator());
    System.out.print(summary);
    appendSummaryToFile(summary.toString());
}

Add these two small helpers:

private double percentile(
    double[] sortedValues,
    double percentile
) {
    if (sortedValues.length == 0) {
        return Double.NaN;
    }
    int index =
        (int) Math.ceil(percentile * sortedValues.length) - 1;
    return sortedValues[index];
}
private boolean isTimeout(CompletableFuture<?> check) {
    return check.handle((ignored, error) -> {
        Throwable cause = error;
        while (cause instanceof CompletionException
                || cause instanceof ExecutionException) {
            cause = cause.getCause();
        }
        return cause instanceof TimeoutException;
    }).join();
}

